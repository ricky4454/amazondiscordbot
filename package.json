{
  "name": "amazondiscordbot",
  "version": "1.0.0",
  "description": "Discord bot that notifies a channel when Amazon products are back in stock.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "doctor": "node src/doctor.js",
    "test": "node --test",
    "watch:list": "node src/manageWatches.js list",
    "watch:add:product": "node src/manageWatches.js add-product",
    "watch:add:brand": "node src/manageWatches.js add-brand",
    "watch:remove": "node src/manageWatches.js remove"
  },
  "engines": {
    "node": ">=20"
  }
}
